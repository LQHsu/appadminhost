# Copia este archivo a .env para usarlo LOCALMENTE (solo lo necesitas
# para correr los comandos de migración contra Postgres — `npm run
# start`/`start:dev` normales siguen usando sqlite sin tocar esto).
#
# En producción (Render) estas mismas variables se configuran como
# "Environment Variables" en el dashboard, no como archivo .env.

# Connection string que te da Neon o Supabase al crear el proyecto,
# algo como:
# postgresql://usuario:password@host.neon.tech/nombre_db?sslmode=require
DATABASE_URL=

# Clave compartida que exige la API en el header `x-api-key` (ver
# src/common/api-key.guard.ts). Sin esta variable, el guard deja pasar
# todo — así no te bloqueas a ti mismo en local. En producción SIEMPRE
# debe estar configurada. Genera una larga y aleatoria, ej:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_KEY=
